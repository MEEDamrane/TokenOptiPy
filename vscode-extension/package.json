{
  "name": "tokenoptipy-vscode",
  "displayName": "TokenOptiPy MCP Traceability",
  "description": "Registers the local TokenOptiPy MCP server and shows tool traceability in one status bar item.",
  "version": "0.2.2",
  "publisher": "meedamrane",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "codex",
    "llm",
    "tokens",
    "prompt",
    "traceability"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MEEDamrane/TokenOptiPy.git",
    "directory": "vscode-extension"
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tokenoptipy.mcp",
        "label": "TokenOptiPy MCP"
      }
    ],
    "configuration": {
      "title": "TokenOptiPy",
      "properties": {
        "tokenoptipy.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to start tokenoptipy.mcp_server."
        },
        "tokenoptipy.traceLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent MCP trace events included in the status-bar tooltip."
        },
        "tokenoptipy.configureCodex": {
          "type": "boolean",
          "default": true,
          "description": "Maintain the TokenOptiPy MCP block in the workspace .codex/config.toml file."
        }
      }
    }
  }
}
