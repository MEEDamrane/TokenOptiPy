{
  "name": "tokenoptipy-vscode",
  "displayName": "TokenOptiPy MCP Traceability",
  "description": "Registers the local TokenOptiPy MCP server and shows tool traceability in one status bar item.",
  "version": "0.4.0",
  "icon": "images/tokenoptipy-icon.png",
  "publisher": "mohamedamrane",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "codex",
    "llm",
    "tokens",
    "prompt",
    "traceability"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MEEDamrane/TokenOptiPy.git",
    "directory": "vscode-extension"
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tokenoptipy.mcp",
        "label": "TokenOptiPy MCP"
      }
    ],
    "configuration": {
      "title": "TokenOptiPy",
      "properties": {
        "tokenoptipy.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to start tokenoptipy.mcp_server."
        },
        "tokenoptipy.traceLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent MCP trace events included in the status-bar tooltip."
        },
        "tokenoptipy.configureCodex": {
          "type": "boolean",
          "default": true,
          "description": "Maintain the TokenOptiPy MCP block in the workspace .codex/config.toml file."
        },
        "tokenoptipy.buildGraphAfterInspect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically regenerate tokenoptipy-out/graph.html when inspect_workspace completes."
        }
      }
    },
    "commands": [
      {
        "command": "tokenoptipy.configureMcpClients",
        "title": "TokenOptiPy: Configure MCP Clients"
      },
      {
        "command": "tokenoptipy.buildGraph",
        "title": "TokenOptiPy: Build TokenGraph"
      },
      {
        "command": "tokenoptipy.buildAndOpenGraph",
        "title": "TokenOptiPy: Build and Open TokenGraph"
      },
      {
        "command": "tokenoptipy.openGraph",
        "title": "TokenOptiPy: Open TokenGraph"
      },
      {
        "command": "tokenoptipy.showPromptFlow",
        "title": "TokenOptiPy: Show Prompt Flow"
      },
      {
        "command": "tokenoptipy.showDetectedLanguages",
        "title": "TokenOptiPy: Show Detected Project Languages"
      }
    ]
  }
}
